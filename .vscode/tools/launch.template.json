{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            // Use the interpreter recorded by `isaaclab --editor`; VS Code skips wrapper scripts such as python.sh
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Train Lightlp-Perc-Loco-T-G1 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": [
                "train",
                "--rl_library", "rsl_rl",
                "--task", "Lightlp-Perc-Loco-T-G1",
                "--num_envs", "4096"            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Play Lightlp-Perc-Loco-T-G1 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": [
                "play",
                "--rl_library", "rsl_rl",
                "--task", "Lightlp-Perc-Loco-T-G1",
                "--num_envs", "32"            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Train Lightlp-Perc-Loco-T-G1 with rsl_rl (DISTILLATION)",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": [
                "train",
                "--rl_library", "rsl_rl",
                "--task", "Lightlp-Perc-Loco-T-G1",
                "--num_envs", "4096"            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Play Lightlp-Perc-Loco-T-G1 with rsl_rl (DISTILLATION)",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": [
                "play",
                "--rl_library", "rsl_rl",
                "--task", "Lightlp-Perc-Loco-T-G1",
                "--num_envs", "32"            ],
            "console": "integratedTerminal"
        },
    ]
}
